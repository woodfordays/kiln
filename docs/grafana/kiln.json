            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Request time and model waits",
      "description": "Wall time of requests, and how long requests waited for their model to be loaded or swapped in.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kiln_request_duration_seconds_bucket{instance=~\"$instance\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "request p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kiln_request_duration_seconds_bucket{instance=~\"$instance\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "request p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kiln_model_wait_seconds_bucket{instance=~\"$instance\",model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "wait for model p95"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Draft acceptance",
      "description": "Share of drafted tokens accepted, for models with speculative decoding (MTP or a draft model).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (model) (rate(kiln_draft_accepted_tokens_total{instance=~\"$instance\",model=~\"$model\"}[$__rate_interval])) / sum by (model) (rate(kiln_draft_tokens_total{instance=~\"$instance\",model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Queue",
      "description": "From each llama-server's own metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (name) (llamacpp:requests_processing{instance=~\"$instance\",model=~\"$model\"})",
          "legendFormat": "{{name}} processing"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (name) (llamacpp:requests_deferred{instance=~\"$instance\",model=~\"$model\"})",
          "legendFormat": "{{name}} waiting for a slot"
        }
      ],
      "options": {
