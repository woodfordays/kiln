{
  "manifest_version": 3,
  "name": "Kiln",
  "version": "0.1.0",
  "description": "Quick actions for a Kiln llama.cpp server: see what's running, switch presets, stop and restart.",
  "icons": { "48": "icons/kiln.svg", "96": "icons/kiln.svg" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiln",
    "default_icon": { "16": "icons/kiln.svg", "32": "icons/kiln.svg" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Open Kiln quick actions" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'" },
  "browser_specific_settings": {
    "gecko": {
      "id": "kiln-quick@kiln.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
