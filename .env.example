# Copy to .env and adjust per box. `./scripts/setup-env.sh` fills in the IDs for you.

# GPU backend: "vulkan" for AMD/Intel, "cuda" for NVIDIA. COMPOSE_FILE adds the matching GPU
# passthrough (compose.amd.yml or compose.nvidia.yml). setup-env.sh detects both.
KILN_BACKEND=vulkan
COMPOSE_FILE=docker-compose.yml:compose.amd.yml

# NVIDIA only: CUDA toolkit version for the image (the driver must support it; 12.8 needs 570+)
# and the GPU architectures to compile for, e.g. 89 for RTX 40, 86;89 for a mixed box.
# "default" compiles for every architecture: portable but a much longer build.
CUDA_VERSION=12.8.1
CUDA_ARCHITECTURES=default

# Where GGUF models live on the host. Mounted at /models; the Hugging Face cache
# is expected at <MODELS_DIR>/hf (HF_HOME) and downloads land in <MODELS_DIR>/gguf.
MODELS_DIR=/opt/models

# Your user and group, and (AMD only) the host groups that own /dev/dri.
KILN_UID=1000
KILN_GID=1000
VIDEO_GID=44
RENDER_GID=993

# Host ports and the interface to bind (127.0.0.1 keeps it local to this box).
KILN_BIND=0.0.0.0
KILN_UI_PORT=8090
KILN_API_PORT=8080

# Optional: HTTP Basic password for the control panel (user "kiln").
KILN_UI_PASSWORD=

# Optional, with a password set: a token for scripts and the browser extension
# (Authorization: Bearer <token>). Generate one with: openssl rand -hex 24
KILN_API_TOKEN=

# Optional: regex of origins allowed to call /api cross-origin. Empty = the default,
# which admits browser extensions (moz-extension://, chrome-extension://) and no websites.
KILN_CORS_ORIGINS=

# Optional: Hugging Face token for gated models. You can also set it in the UI,
# or rely on the CLI login already stored in <MODELS_DIR>/hf/token.
HF_TOKEN=

# llama.cpp commit, tag or branch to build.
LLAMA_CPP_REF=ff0dbb975e93a9a2899efa34bdd32d1c5cfbc183
