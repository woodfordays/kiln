# Copy to .env and adjust per box. `./scripts/setup-env.sh` fills in the IDs for you.

# Where GGUF models live on the host. Mounted at /models; the Hugging Face cache
# is expected at <MODELS_DIR>/hf (HF_HOME) and downloads land in <MODELS_DIR>/gguf.
MODELS_DIR=/opt/models

# Your user and group, and the host groups that own /dev/dri.
KILN_UID=1000
KILN_GID=1000
VIDEO_GID=44
RENDER_GID=993

# Host ports and the interface to bind (127.0.0.1 keeps it local to this box).
KILN_BIND=0.0.0.0
KILN_UI_PORT=8090
KILN_API_PORT=8080

# Optional: HTTP Basic password for the control panel (user "kiln").
KILN_UI_PASSWORD=

# Optional: Hugging Face token for gated models. You can also set it in the UI,
# or rely on the CLI login already stored in <MODELS_DIR>/hf/token.
HF_TOKEN=

# llama.cpp commit, tag or branch to build.
LLAMA_CPP_REF=ff0dbb975e93a9a2899efa34bdd32d1c5cfbc183
